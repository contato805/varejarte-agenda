{
  "name": "Client",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Nome da empresa cliente"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o cliente est\u00e1 ativo"
    },
    "monthly_contract_value": {
      "type": "number",
      "description": "Valor do contrato mensal (receita estimada)"
    },
    "contacts": {
      "type": "array",
      "description": "Lista de contatos da empresa",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "birthday_day": {
            "type": "number"
          },
          "birthday_month": {
            "type": "number"
          }
        }
      }
    },
    "branches": {
      "type": "array",
      "description": "Filiais/unidades de neg\u00f3cio do cliente",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da filial"
          },
          "address": {
            "type": "string",
            "description": "Endere\u00e7o da filial"
          },
          "active": {
            "type": "boolean",
            "default": true,
            "description": "Se a filial est\u00e1 ativa"
          },
          "monthly_activities": {
            "type": "array",
            "description": "Atividades mensais previstas para esta filial",
            "items": {
              "type": "object",
              "properties": {
                "activity_type": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "duration_minutes": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "monthly_activities": {
      "type": "array",
      "description": "Atividades mensais previstas para o cliente (geral)",
      "items": {
        "type": "object",
        "properties": {
          "activity_type": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "duration_minutes": {
            "type": "number"
          }
        }
      }
    },
    "activity_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o cliente"
    }
  },
  "required": [
    "company_name"
  ]
}